<!DOCTYPE html>
<html>
  <head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <title><%= content_for(:title) || "Lupus App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#dc3545" />

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>

    <script>
      // Register Service Worker for offline support
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js')
            .then(reg => console.log('SW registered:', reg.scope))
            .catch(err => console.log('SW registration failed:', err));
        });
      }
    </script>
  </head>
  <body>
    <main>
      <%= yield %>
    </main>
  </body>


  <footer style="background-color: #ffffff; color: #111827; padding: 2rem 1rem;">
  <div style="display: flex; justify-content: <%= turbo_native_app? ? 'center' : 'space-between' %>; align-items: center; flex-wrap: wrap; gap: 1rem; max-width: 1200px; margin: 0 auto;">

    <% unless turbo_native_app? %>
    <!-- App Store Buttons (Left) - Hidden on native apps -->
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href="https://play.google.com/store/apps/details?id=uab.lupasdecisionaid2" target="_blank">
        <img src="https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg"
             alt="Get it on Google Play"
             style="height: 50px;" />
      </a>
      <a href="https://apps.apple.com/us/app/managemylupus/id1550959573" target="_blank">
        <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg"
             alt="Download on the App Store"
             style="height: 50px;" />
      </a>
    </div>
    <% end %>

    <!-- Brand Logo -->
    <div>
      <img src="<%= asset_path('uab_medicine.jpg') %>" alt="Lupus App Logo" style="height: 50px;" />
    </div>

  </div>

  <% unless turbo_native_app? %>
    <div style="text-align: center; margin-top: 1rem; padding-bottom: 0.5rem;">
      <a href="<%= admin_cards_path %>" style="color: #9ca3af; font-size: 0.75rem; text-decoration: none;">
        Admin
      </a>
    </div>
  <% end %>
</footer>


</html>

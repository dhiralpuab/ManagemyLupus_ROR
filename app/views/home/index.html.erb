<div class="image-container">
  <img src="<%= asset_path('lupus_head.png') %>" alt="Lupus Head" />
</div>

<div class="image-container" style="padding: 2rem 1rem; flex-direction: column; align-items: center;">
  <div style="text-align: center;">
    <h2 style="font-size: 2rem; margin-bottom: 1.5rem;">Download the Free App</h2>
  </div>

  <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
    <a href="https://play.google.com/store/apps/details?id=uab.lupasdecisionaid2" target="_blank">
      <img src="https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg"
           alt="Get it on Google Play"
           style="height: 70px; max-width: 90vw;" />
    </a>
    <a href="https://apps.apple.com/us/app/managemylupus/id1550959573" target="_blank">
      <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg"
           alt="Download on the App Store"
           style="height: 70px; max-width: 90vw;" />
    </a>
  </div>
</div>



<div class="image-container">

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2><i class="bi bi-collection me-2"></i>All Cards</h2>
</div>

<!-- Search and Filters -->
<div class="card mb-4">
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label fw-bold">Search</label>
        <input type="text" id="cardSearch" class="form-control" placeholder="Search by title...">
      </div>
      <div class="col-md-2">
        <label class="form-label fw-bold">Target Audience</label>
        <select id="filterCategory" class="form-select">
          <option value="">All</option>
          <option value="active_kidneys">Active Kidneys</option>
          <option value="quiet">Quiet</option>
          <option value="female">Female</option>
          <option value="male">Male</option>
          <option value="a">A (Hydroxychloroquine)</option>
          <option value="b">B (Immunosuppressants)</option>
          <option value="c">C (Biologics)</option>
          <option value="d">D (On steroids)</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-bold">Back Link</label>
        <select id="filterBackLink" class="form-select">
          <option value="">All</option>
          <option value="has">Has back link</option>
          <option value="none">No back link</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-bold">Image</label>
        <select id="filterImage" class="form-select">
          <option value="">All</option>
          <option value="has">Has image</option>
          <option value="none">No image</option>
        </select>
      </div>
    </div>
    <div class="mt-3">
      <button id="clearFilters" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-x-circle me-1"></i>Clear Filters
      </button>
      <span id="filterCount" class="ms-3 text-muted"></span>
    </div>
  </div>
</div>

<% @categories.each do |category, cards| %>
  <div class="card mb-4 category-section" data-category="<%= category %>">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">
        <i class="bi bi-folder me-2"></i><%= category.to_s.titleize %>
        <span class="badge bg-secondary ms-2 category-count"><%= cards.count %> cards</span>
        <% if CardVersionService.has_versions?(category) %>
          <span class="badge bg-success version-badge ms-2">
            <i class="bi bi-check-circle"></i> Has custom edits
          </span>
        <% end %>
      </h5>
      <div class="d-flex gap-2">
        <a href="<%= admin_new_card_path(category: category) %>" class="btn btn-sm btn-success">
          <i class="bi bi-plus-lg"></i> Add Card
        </a>
        <a href="<%= history_admin_cards_path(category: category) %>" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-clock-history"></i> History
        </a>
      </div>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <% cards.each_with_index do |card, index| %>
          <div class="col-md-4 col-lg-3 card-item <%= 'initially-hidden' if index >= 6 %>"
               data-title="<%= card.title.downcase %>"
               data-section="<%= category %>"
               data-categories="<%= card.categories.join(',') %>"
               data-has-backlink="<%= card.learn_more_id.present? %>"
               data-has-image="<%= card.image_url.present? %>">
            <div class="card card-preview h-100" onclick="window.location='<%= admin_edit_card_path(id: card.id, category: category) %>'">
              <% if card.image_url.present? %>
                <%= image_tag card.image_url, class: "card-img-top", style: "height: 120px; object-fit: cover;", onerror: "this.style.display='none'" %>
              <% else %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 120px;">
                  <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                </div>
              <% end %>
              <div class="card-body p-2">
                <h6 class="card-title mb-1" style="font-size: 0.9rem;">
                  #<%= card.id %> - <%= truncate(card.title, length: 40) %>
                </h6>
                <div class="d-flex flex-wrap gap-1">
                  <% if card.hidden? %>
                    <span class="badge bg-warning">Hidden</span>
                  <% end %>
                  <% if card.learn_more_id.present? %>
                    <span class="badge bg-info"><i class="bi bi-link"></i> Back link</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <% if cards.count > 6 %>
          <div class="col-12 show-more-container">
            <button class="btn btn-link show-more-btn" type="button" data-category="<%= category %>">
              Show <%= cards.count - 6 %> more cards...
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<style>
  .card-item.initially-hidden {
    display: none;
  }
  .card-item.initially-hidden.show-all {
    display: block;
  }
  .card-item.filtered-out {
    display: none !important;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('cardSearch');
  const filterCategory = document.getElementById('filterCategory');
  const filterBackLink = document.getElementById('filterBackLink');
  const filterImage = document.getElementById('filterImage');
  const clearFiltersBtn = document.getElementById('clearFilters');
  const filterCountEl = document.getElementById('filterCount');
  const cardItems = document.querySelectorAll('.card-item');
  const categorySections = document.querySelectorAll('.category-section');
  const showMoreBtns = document.querySelectorAll('.show-more-btn');

  // Show more buttons
  showMoreBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      const category = this.getAttribute('data-category');
      const section = document.querySelector('.category-section[data-category="' + category + '"]');
      const hiddenCards = section.querySelectorAll('.card-item.initially-hidden');

      hiddenCards.forEach(function(card) {
        card.classList.add('show-all');
      });

      this.closest('.show-more-container').style.display = 'none';
    });
  });

  function applyFilters() {
    const query = searchInput.value.toLowerCase().trim();
    const categoryFilter = filterCategory.value;
    const backLinkFilter = filterBackLink.value;
    const imageFilter = filterImage.value;
    const hasFilters = query || categoryFilter || backLinkFilter || imageFilter;

    let visibleCount = 0;
    let totalCount = cardItems.length;

    // When filtering, show all cards (remove initially-hidden behavior)
    if (hasFilters) {
      cardItems.forEach(function(item) {
        item.classList.add('show-all');
      });
      document.querySelectorAll('.show-more-container').forEach(function(el) {
        el.style.display = 'none';
      });
    }

    cardItems.forEach(function(item) {
      const title = item.getAttribute('data-title') || '';
      const categories = (item.getAttribute('data-categories') || '').split(',');
      const hasBackLink = item.getAttribute('data-has-backlink') === 'true';
      const hasImage = item.getAttribute('data-has-image') === 'true';

      let visible = true;

      // Search filter
      if (query && !title.includes(query)) {
        visible = false;
      }

      // Target audience filter (card must have this category)
      if (categoryFilter && !categories.includes(categoryFilter)) {
        visible = false;
      }

      // Back link filter
      if (backLinkFilter === 'has' && !hasBackLink) {
        visible = false;
      } else if (backLinkFilter === 'none' && hasBackLink) {
        visible = false;
      }

      // Image filter
      if (imageFilter === 'has' && !hasImage) {
        visible = false;
      } else if (imageFilter === 'none' && hasImage) {
        visible = false;
      }

      if (visible) {
        item.classList.remove('filtered-out');
        visibleCount++;
      } else {
        item.classList.add('filtered-out');
      }
    });

    // Show/hide category sections based on visible cards
    categorySections.forEach(function(section) {
      const visibleCards = section.querySelectorAll('.card-item:not(.filtered-out)');

      if (visibleCards.length === 0) {
        section.style.display = 'none';
      } else {
        section.style.display = '';
        // Update visible count in badge
        const countBadge = section.querySelector('.category-count');
        if (hasFilters) {
          countBadge.textContent = visibleCards.length + ' visible';
        } else {
          const allCards = section.querySelectorAll('.card-item');
          countBadge.textContent = allCards.length + ' cards';
        }
      }
    });

    // Update filter count
    if (hasFilters) {
      filterCountEl.textContent = 'Showing ' + visibleCount + ' of ' + totalCount + ' cards';
    } else {
      filterCountEl.textContent = '';
    }
  }

  // Reset show more when filters cleared
  function resetShowMore() {
    cardItems.forEach(function(item) {
      item.classList.remove('show-all');
      item.classList.remove('filtered-out');
    });
    document.querySelectorAll('.show-more-container').forEach(function(el) {
      el.style.display = '';
    });
    categorySections.forEach(function(section) {
      section.style.display = '';
      const allCards = section.querySelectorAll('.card-item');
      const countBadge = section.querySelector('.category-count');
      countBadge.textContent = allCards.length + ' cards';
    });
    filterCountEl.textContent = '';
  }

  // Event listeners
  searchInput.addEventListener('input', applyFilters);
  filterCategory.addEventListener('change', applyFilters);
  filterBackLink.addEventListener('change', applyFilters);
  filterImage.addEventListener('change', applyFilters);

  clearFiltersBtn.addEventListener('click', function() {
    searchInput.value = '';
    filterCategory.value = '';
    filterBackLink.value = '';
    filterImage.value = '';
    resetShowMore();
  });
});
</script>

<style>
  .diff-old { background: #ffebe9; padding: 4px 8px; border-left: 3px solid #dc3545; margin: 2px 0; }
  .diff-new { background: #e6ffec; padding: 4px 8px; border-left: 3px solid #28a745; margin: 2px 0; }
  .diff-line-num { color: #888; font-size: 0.8em; margin-right: 8px; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>
    <i class="bi bi-git me-2"></i>Changes
    <span class="badge bg-secondary"><%= @category.to_s.titleize %></span>
  </h2>
  <div>
    <%= button_to restore_version_admin_cards_path(category: @category, version: @version),
        method: :post, form: { data: { turbo: false }, class: "d-inline" },
        class: "btn btn-warning btn-sm me-2",
        onclick: "return confirm('Restore this version?')" do %>
      <i class="bi bi-arrow-counterclockwise"></i> Restore
    <% end %>
    <%= link_to history_admin_cards_path(category: @category), class: "btn btn-outline-secondary btn-sm" do %>
      Back
    <% end %>
  </div>
</div>

<% if @cards %>
  <% if @previous_version %>
    <p class="text-muted small">Comparing <code><%= @version %></code> to <code><%= @previous_version %></code></p>
  <% end %>

  <% total = @changes[:added].count + @changes[:removed].count + @changes[:modified].count %>

  <% if total == 0 %>
    <div class="alert alert-light border">No changes</div>
  <% else %>

    <% @changes[:added].each do |card| %>
      <div class="alert alert-success py-2">
        <strong>+ Added Card #<%= card[:id] %></strong>: <%= card[:title] %>
      </div>
    <% end %>

    <% @changes[:removed].each do |card| %>
      <div class="alert alert-danger py-2">
        <strong>- Removed Card #<%= card[:id] %></strong>: <%= card[:title] %>
      </div>
    <% end %>

    <% @changes[:modified].each do |mod| %>
      <div class="card mb-3">
        <div class="card-header py-2">
          <strong>Card #<%= mod[:card][:id] %></strong>: <%= mod[:card][:title] %>
        </div>
        <div class="card-body py-2">
          <% mod[:changes].each do |change| %>
            <div class="mb-3">
              <strong class="text-muted small"><%= change[:field] %></strong>

              <% if change[:changed_lines] %>
                <!-- Description changes - show only changed lines -->
                <% change[:changed_lines].each do |cl| %>
                  <div class="mt-1">
                    <span class="diff-line-num">Line <%= cl[:index] %>:</span>
                    <% if cl[:old].present? %>
                      <div class="diff-old"><del><%= cl[:old] %></del></div>
                    <% end %>
                    <% if cl[:new].present? %>
                      <div class="diff-new"><%= cl[:new] %></div>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <!-- Simple field change -->
                <div class="diff-old"><del><%= change[:from] %></del></div>
                <div class="diff-new"><%= change[:to] %></div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  <% end %>
<% else %>
  <div class="alert alert-danger">Could not load version.</div>
<% end %>

<!-- In your layout or page header -->
<nav class="bg-white border-bottom shadow-sm sticky-top">
  <div class="container d-flex flex-wrap justify-content-between align-items-center py-2">
    <!-- App title or logo -->
    <%= link_to root_path, class: "text-decoration-none text-dark" do %>
      <div class="fw-bold fs-5">Lupus App</div>
    <% end %>

    <ul class="nav nav-tabs mb-4">
      <% tabs = {
        "basic" => "Intro",
        "steroids" => "Steroids",
        "treatment" => "Treatment",
        "biologic" => "Biologic/Med",
        "sexspissues" => "Sex Sp Issues",
        "foryou" => "For you"
      } %>
      <% current_status = session[:survey]&.[]("status") %>
      <% notes = session[:survey]&.[]("notes") %>
      <% tabs.each do |key, label| %>
        <% next if key == "treatment" && current_status == "quiet" %>  
        <% next if key == "foryou" && notes == "" %>
        <li class="nav-item">
          <%= link_to label, survey_next_path(category: key), class: [
        "nav-link",
        ("active" if params[:category] == key || (params[:category].blank? && key == "basic")),
        ("foryou-glow" if key == "foryou")
      ].compact.join(" ") %>
        </li>
      <% end %>
    </ul>

  </div>
</nav>


<!-- Cards list (same as before) -->
<div class="container my-4">
  <div class="row gy-4">
    <% @cards.each_with_index do |card, index| %>
      <div class="col-12">
        <div class="card d-flex flex-row align-items-center shadow-sm p-3" 
             role="button" 
             data-index="<%= index %>" 
             id="card-<%= card.id %>">
          <img src="<%= asset_path(card.image_url) %>" class="img-fluid rounded me-3" alt="<%= card.title %>" style="width: 100px; height: 100px; object-fit: cover;">
          <div class="flex-grow-1">
            <h5 class="card-title mb-1"><%= card.title %></h5>
            <p class="card-text text-muted">
              <% desc_text = card.description.is_a?(Array) ? card.description.join(' ') : card.description %>
              <%= truncate(desc_text, length: 60) %>
            </p>

          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Single modal -->
<div class="modal fade" id="singleModal" tabindex="-1" aria-labelledby="singleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
    <div class="modal-content overflow-hidden position-relative">
      <div class="modal-header">
        <h5 class="modal-title" id="singleModalLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <img src="" alt="" id="modalImage" class="rounded" style="max-height: 400px; max-width: 35%; width: auto; object-fit: contain; flex-shrink: 0;">

        <div id="modalDescription" style="max-width: 600px; text-align: left; margin: 0 auto;"></div>
      </div>
      <div class="modal-footer justify-content-between">
        <button type="button" class="btn btn-light" id="prevBtn" aria-label="Previous">&lsaquo; Prev</button>
        <button type="button" class="btn btn-primary" id="learnBtn" aria-label="Learn more">Click here to learn more</button>
        <button type="button" class="btn btn-light" id="nextBtn" aria-label="Next">Next &rsaquo;</button>
      </div>
    </div>
  </div>
</div>

<!-- Learn more modal -->
<div class="modal fade" id="learnModal" tabindex="-1" aria-labelledby="learnModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
    <div class="modal-content overflow-hidden position-relative ">
      <div class="modal-header">
        <h5 class="modal-title" id="learnModalLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <img src="" alt="" id="learnModalImage" class="rounded" style="max-height: 400px; max-width: 35%; width: auto; object-fit: contain; flex-shrink: 0;">

        <div id="learnModalDescription" style="max-width: 600px; text-align: left; margin: 0 auto;"></div>
      </div>
      <div class="modal-footer justify-content-center">
        <button type="button" class="btn btn-primary" id="learn-learnBtn" aria-label="Learn more">Click here to learn more</button>
      </div>
    </div>
  </div>
</div>


<!-- Floating Chat Button -->
<button id="chatButton" class="btn btn-primary rounded-circle shadow-lg"
        style="position: fixed; bottom: 20px; right: 20px; width: 60px; height: 60px; z-index: 1055;">
  💬
</button>

<!-- Chat Box -->
<div id="chatBox" class="card shadow-lg border-0"
     style="position: fixed; bottom: 90px; right: 20px; width: 320px; height: 400px;
            display: none; z-index: 1055; border-radius: 1rem; overflow: hidden;">
  <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2 px-3">
    <span>Chat Support</span>
    <button type="button" class="btn-close btn-close-white" id="closeChat"></button>
  </div>
  <div class="card-body d-flex flex-column p-2" style="height: calc(100% - 45px);">
    <div id="chatMessages" class="flex-grow-1 overflow-auto mb-2 border rounded p-2 bg-light">
      <p class="text-muted small">👋 Hi! How can we help you today? (AI NOT CONNECTED, PLEASE CHECK BACK LATER) </p>
    </div>
    <form id="chatForm" class="d-flex">
      <input type="text" id="chatInput" class="form-control me-2" placeholder="Type a message..." autocomplete="off">
      <button type="submit" class="btn btn-primary">Send</button>
    </form>
  </div>
</div>


<script>
  document.addEventListener("turbo:load", () => {
    const cards = <%= raw @cards.map { |card| 
        {
          id: card.id,
          title: card.title,
          description: card.description,
          categories: card.categories,
          image_url: asset_path(card.image_url),
          learn_more: card.learn_more,
          learn_more_id: card.learn_more_id
        }
      }.to_json.html_safe %> ;
    const allCards = <%= raw @learn_more_cards.map { |card|
    {
      id: card.id,
      title: card.title,
      description: card.description,
      image_url: asset_path(card.image_url),
      learn_more: card.learn_more,
      learn_more_id: card.learn_more_id
    }
  }.to_json.html_safe %>;

    const modalEl = document.getElementById('singleModal');
    const learnModalEl = document.getElementById('learnModal');
    
    //Dispose existing modal instance if any, then create new one
    let modalInstance = bootstrap.Modal.getInstance(modalEl);
    if (modalInstance) {
      modalInstance.dispose();
    }
    modalInstance = new bootstrap.Modal(modalEl);

    // Clean up backdrop and body classes on modal close
    modalEl.addEventListener('hidden.bs.modal', () => {
      document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
      document.body.classList.remove('modal-open');
      document.body.style.paddingRight = '';
    });

    let currentIndex = 0;
    let learnIndex = 0;
    const modalLabel = document.getElementById('singleModalLabel');
    const modalLearnMore = document.getElementById('learnBtn');
    const modalImage = document.getElementById('modalImage');
    const modalDescription = document.getElementById('modalDescription');
    const modalContent = modalEl.querySelector('.modal-content');

    const learnModalLabel = document.getElementById('learnModalLabel');
    const learnModalImage = document.getElementById('learnModalImage');
    const modalLearnLearnMore = document.getElementById('learn-learnBtn');
    const learnModalDescription = document.getElementById('learnModalDescription');
    // const learnModalContent = learnModalEl.querySelector('.learn-modal-content');

    function showModalContent(index, direction = null) {
      if (index < 0) index = cards.length - 1;
      if (index >= cards.length) index = 0;

      const card = cards[index];

      if (direction) {
        modalContent.style.transition = 'transform 0.4s ease';
        modalContent.style.transform = `translateX(${direction === 'next' ? '-100%' : '100%'})`;

        setTimeout(() => {
          modalLabel.textContent = card.title;
          modalImage.src = card.image_url;
          modalImage.alt = card.title;

          if (Array.isArray(card.description)) {
            modalDescription.innerHTML = '<ul>' + card.description.map(point => `<li>${point}</li>`).join('') + '</ul>';
          } else {
            modalDescription.textContent = card.description;
          }

          modalContent.style.transition = 'none';
          modalContent.style.transform = `translateX(${direction === 'next' ? '100%' : '-100%'})`;

          requestAnimationFrame(() => {
            modalContent.style.transition = 'transform 0.4s ease';
            modalContent.style.transform = 'translateX(0)';
          });
        }, 400);
      } else {
        modalLabel.textContent = card.title;
        modalImage.src = card.image_url;
        modalImage.alt = card.title;
        if (card.learn_more) {
          modalLearnMore.textContent = card.learn_more;
          modalLearnMore.style.display = "block";   // show button
        } else {
          modalLearnMore.style.display = "none";    // hide button
        }

        if (Array.isArray(card.description)) {
          modalDescription.innerHTML = '<ul>' + card.description.map(point => `<li>${point}</li>`).join('') + '</ul>';
        } else {
          modalDescription.textContent = card.description;
        }
        
        modalContent.style.transform = 'translateX(0)';
      }

      currentIndex = index;
      learnIndex = card.learn_more_id;
    }

    function showLearnContent(index, learnIndex = null) {
      let card = learnIndex ? allCards.find(c => c.id === learnIndex) : cards[index];
      if (!card || !card.learn_more_id) return;

      const learnCard = allCards.find(c => c.id === card.learn_more_id);
      if (!learnCard) return;

      // Get any currently shown modal
      const openModalEl = document.querySelector('.modal.show');
      const showNextLearnModal = () => {
        // Populate learn modal content
        learnModalLabel.textContent = learnCard.title;
        learnModalImage.src = learnCard.image_url;
        learnModalImage.alt = learnCard.title;

        if (Array.isArray(learnCard.description)) {
          learnModalDescription.innerHTML =
            '<ul>' + learnCard.description.map(p => `<li>${p}</li>`).join('') + '</ul>';
        } else {
          learnModalDescription.textContent = learnCard.description;
        }

        if (learnCard.learn_more) {
          modalLearnLearnMore.style.display = 'block';
          modalLearnLearnMore.onclick = () => showLearnContent(null, learnCard.learn_more_id);
        } else {
          modalLearnLearnMore.style.display = 'none';
        }

        const learnModalInstance = bootstrap.Modal.getOrCreateInstance(learnModalEl);
        learnModalInstance.show();
      };

      if (openModalEl) {
        const openModalInstance = bootstrap.Modal.getInstance(openModalEl);
        if (openModalInstance) {
          // Wait for it to fully hide, then show next modal
          openModalEl.addEventListener('hidden.bs.modal', function handler() {
            openModalEl.removeEventListener('hidden.bs.modal', handler);
            showNextLearnModal();
          });
          openModalInstance.hide();
        } else {
          showNextLearnModal();
        }
      } else {
        showNextLearnModal();
      }
    }




    // Remove any leftover backdrops before showing modal (extra safety)
    function cleanBackdrops() {
      document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
      document.body.classList.remove('modal-open');
      document.body.style.paddingRight = '';
    }

    // Add event listeners to cards
    document.querySelectorAll('.card[role="button"]').forEach(cardEl => {
      cardEl.addEventListener('click', () => {
        cleanBackdrops();
        currentIndex = parseInt(cardEl.getAttribute('data-index'));
        showModalContent(currentIndex);
        modalInstance.show();
      });
    });
    document.getElementById('learnBtn').addEventListener('click', () => {
      cleanBackdrops();
      showLearnContent(currentIndex);
    });

    document.getElementById('learn-learnBtn').addEventListener('click', () => {
      cleanBackdrops();
      showLearnContent(null,learnIndex);
    });

    // Prev/Next buttons
    document.getElementById('prevBtn').addEventListener('click', () => {
      showModalContent(currentIndex - 1, 'prev');
    });

    document.getElementById('nextBtn').addEventListener('click', () => {
      showModalContent(currentIndex + 1, 'next');
    });
  });

</script>

<script>
  document.addEventListener("turbo:load", () => {
    const chatButton = document.getElementById("chatButton");
    const chatBox = document.getElementById("chatBox");
    const closeChat = document.getElementById("closeChat");
    const chatForm = document.getElementById("chatForm");
    const chatInput = document.getElementById("chatInput");
    const chatMessages = document.getElementById("chatMessages");

    // Toggle open/close
    chatButton.addEventListener("click", () => {
      chatBox.style.display = chatBox.style.display === "none" ? "block" : "none";
    });

    closeChat.addEventListener("click", () => {
      chatBox.style.display = "none";
    });

    // Handle sending a message (simple local echo)
    chatForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const message = chatInput.value.trim();
      if (!message) return;

      const msgEl = document.createElement("div");
      msgEl.className = "text-end";
      msgEl.innerHTML = `<span class="badge bg-primary text-wrap">${message}</span>`;
      chatMessages.appendChild(msgEl);

      chatInput.value = "";
      chatMessages.scrollTop = chatMessages.scrollHeight;

      // Simulated bot response (you can replace with real API later)
      setTimeout(() => {
        const reply = document.createElement("div");
        reply.className = "text-start";
        reply.innerHTML = `<br><span class="badge bg-secondary text-wrap">Thanks for your message! We are still working on this feature.</span>`;
        chatMessages.appendChild(reply);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }, 1000);
    });
  });
</script>

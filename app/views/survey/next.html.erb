        style="position: fixed; bottom: 20px; right: 20px; width: 60px; height: 60px; z-index: 1055;">
  💬
</button> -->

<!-- Chat Box -->
<div id="chatBox" class="card shadow-lg border-0"
     style="position: fixed; bottom: 90px; right: 20px; width: 320px; height: 400px;
            display: none; z-index: 1055; border-radius: 1rem; overflow: hidden;">
  <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2 px-3">
    <span>Chat Support</span>
    <button type="button" class="btn-close btn-close-white" id="closeChat"></button>
  </div>
  <div class="card-body d-flex flex-column p-2" style="height: calc(100% - 45px);">
    <div id="chatMessages" class="flex-grow-1 overflow-auto mb-2 border rounded p-2 bg-light">
      <p class="text-muted small">👋 Hi! How can we help you today? (AI NOT CONNECTED, PLEASE CHECK BACK LATER) </p>
    </div>
    <form id="chatForm" class="d-flex">
      <input type="text" id="chatInput" class="form-control me-2" placeholder="Type a message..." autocomplete="off">
      <button type="submit" class="btn btn-primary">Send</button>
    </form>
  </div>
</div>


<script>
document.addEventListener("turbo:load", () => {

  /* -------------------------
     SAFETY HELPERS
  ------------------------- */
  const byId = (id) => document.getElementById(id);
  const exists = (el) => el !== null;

  function cleanBackdrops() {
    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
    document.body.classList.remove('modal-open');
    document.body.style.paddingRight = '';
  }

  function closeAllModals() {
    // Hide modals using Bootstrap's API
    if (modalInstance) modalInstance.hide();
    if (learnModalInstance) learnModalInstance.hide();
  }


  /* -------------------------
     DATA FROM RAILS
  ------------------------- */
  const cards = <%= raw @cards.map { |card|
    {
      id: card.id,
      title: card.title,
      description: card.description,
      categories: card.categories,
      image_url: asset_path(card.image_url),
      learn_more: card.learn_more,
      learn_more_id: card.learn_more_id
    }
  }.to_json.html_safe %>;
  

  const allCards = <%= raw @learn_more_cards.map { |card|
    {
      id: card.id,
      title: card.title,
      description: card.description,
      image_url: asset_path(card.image_url),
      learn_more: card.learn_more,
      learn_more_id: card.learn_more_id
    }
  }.to_json.html_safe %>;

  if (!cards || cards.length === 0) return;

  /* -------------------------
     MODAL ELEMENTS
  ------------------------- */
  const modalEl = byId('singleModal');
  const learnModalEl = byId('learnModal');

  if (!modalEl) return;

  let modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl, {
    backdrop: true,
    focus: true
  });

  let learnModalInstance = learnModalEl
    ? bootstrap.Modal.getOrCreateInstance(learnModalEl, {
        backdrop: true,
        focus: true
      })
    : null;


  let currentIndex = 0;
  let learnIndex = null;

  const modalLabel = byId('singleModalLabel');
  const modalId = byId('singleModalId');
  const modalImage = byId('modalImage');
  const modalDescription = byId('modalDescription');
  const modalLearnBtn = byId('learnBtn');
  const modalContent = modalEl.querySelector('.modal-content');

  const learnModalLabel = byId('learnModalLabel');
  const learnModalImage = byId('learnModalImage');
  const learnModalDescription = byId('learnModalDescription');
  const learnLearnBtn = byId('learn-learnBtn');

  /* -------------------------
     MAIN MODAL CONTENT
  ------------------------- */
  function showModalContent(index, direction = null) {
  
    if (index < 0) index = 0;

    if (exists(byId('nextBtn'))) {
      if (index >= cards.length - 1) {
        byId('nextBtn').style.display = 'none';
      } else {
        byId('nextBtn').style.display = 'inline-block';
      }
    }

   

    const card = cards[index];
    if (!card) return;

    const render = () => {
      modalId.textContent = card.id;
      modalLabel.textContent = card.title;
      modalImage.src = card.image_url;
      modalImage.alt = card.title;

      if (Array.isArray(card.description)) {
        modalDescription.innerHTML =
          '<ul>' + card.description.map(p => `<li>${p}</li>`).join('') + '</ul>';
      } else {
        modalDescription.textContent = card.description;
      }

      if (card.learn_more) {
        modalLearnBtn.style.display = "block";
        modalLearnBtn.textContent = card.learn_more;
      } else {
        modalLearnBtn.style.display = "none";
      }

      currentIndex = index;
      learnIndex = card.learn_more_id;
    };

    if (direction && modalContent) {
      modalContent.style.transition = 'transform 0.3s ease';
      modalContent.style.transform =
        direction === 'next' ? 'translateX(-100%)' : 'translateX(100%)';

      setTimeout(() => {
        render();
        modalContent.style.transition = 'none';
        modalContent.style.transform =
          direction === 'next' ? 'translateX(100%)' : 'translateX(-100%)';

        requestAnimationFrame(() => {
          modalContent.style.transition = 'transform 0.3s ease';
          modalContent.style.transform = 'translateX(0)';
        });
      }, 300);
    } else {
      render();
    }
  }

  /* -------------------------
     LEARN MORE MODAL
  ------------------------- */
  function showLearnContent(fromLearnId = null) {
    const card = fromLearnId
      ? allCards.find(c => c.id === fromLearnId)
      : allCards.find(c => c.id === learnIndex);

    if (!card || !learnModalInstance) return;

    learnModalLabel.textContent = card.title;
    learnModalImage.src = card.image_url;
    learnModalImage.alt = card.title;

    if (Array.isArray(card.description)) {
      learnModalDescription.innerHTML =
        '<ul>' + card.description.map(p => `<li>${p}</li>`).join('') + '</ul>';
    } else {
      learnModalDescription.textContent = card.description;
    }

    if (card.learn_more_id) {
      learnLearnBtn.style.display = "block";
      learnLearnBtn.onclick = () => showLearnContent(card.learn_more_id);
    } else {
      learnLearnBtn.style.display = "none";
    }

    modalInstance.hide();
    learnModalInstance.show();
  }

  /* -------------------------
     EVENT LISTENERS
  ------------------------- */
  document.querySelectorAll('.card[role="button"]').forEach(cardEl => {
    cardEl.addEventListener('click', () => {
      // cleanBackdrops();
      currentIndex = parseInt(cardEl.dataset.index, 10);
      showModalContent(currentIndex);
      modalInstance.show();
    });
  });

  if (exists(byId('prevBtn'))) {
    byId('prevBtn').addEventListener('click', () =>
      showModalContent(currentIndex - 1, 'prev')
    );
  }

  if (exists(byId('nextBtn'))) {
    byId('nextBtn').addEventListener('click', () =>
      showModalContent(currentIndex + 1, 'next')
    );
  }

  if (exists(modalLearnBtn)) {
    modalLearnBtn.addEventListener('click', () => {
      // cleanBackdrops();
      closeAllModals();
      showLearnContent();
    });
  }

  if (learnModalEl) {
    learnModalEl.addEventListener('hidden.bs.modal', () => {
    // cleanBackdrops();
      closeAllModals();
      setTimeout(() => modalInstance.show(), 100);
    });
  }

});
</script>

<script>
document.addEventListener("turbo:load", () => {
  const chatBox = document.getElementById("chatBox");
  const closeChat = document.getElementById("closeChat");
  const chatForm = document.getElementById("chatForm");
  const chatInput = document.getElementById("chatInput");
  const chatMessages = document.getElementById("chatMessages");

  if (!chatBox) return;

  closeChat?.addEventListener("click", () => {
    chatBox.style.display = "none";
  });

  chatForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const message = chatInput.value.trim();
    if (!message) return;

    chatMessages.insertAdjacentHTML(
      "beforeend",
      `<div class="text-end">
        <span class="badge bg-primary text-wrap">${message}</span>
      </div>`
    );

    chatInput.value = "";
    chatMessages.scrollTop = chatMessages.scrollHeight;

    setTimeout(() => {
      chatMessages.insertAdjacentHTML(
        "beforeend",
        `<div class="text-start mt-2">
          <span class="badge bg-secondary text-wrap">
            Thanks for your message! We are still working on this feature.
          </span>
        </div>`
      );
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }, 800);
  });
});
</script>

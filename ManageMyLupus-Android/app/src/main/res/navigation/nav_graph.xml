<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/web_fragment">

    <fragment
        android:id="@+id/web_fragment"
        android:name="com.managemylupus.app.WebFragment"
        android:label="ManageMyLupus">
        <argument
            android:name="location"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <dialog
        android:id="@+id/web_bottom_sheet_fragment"
        android:name="com.managemylupus.app.WebBottomSheetDialogFragment"
        android:label="Details">
        <argument
            android:name="location"
            app:argType="string" />
    </dialog>

</navigation>
